{
  "name": "obsidian-seam",
  "version": "2.0.1",
  "description": "Tag-driven note organization with automatic archiving and a Universal Palette.",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "symlink": "node scripts/symlink.mjs --dir=seam_test_vault",
    "changelog:extract": "node scripts/changelog.mjs extract",
    "changelog:generate": "node scripts/changelog.mjs generate",
    "changelog:validate": "node scripts/changelog.mjs validate",
    "release:check": "node scripts/changelog.mjs validate",
    "install:local": "pnpm build && pnpm symlink && obsidian vault='seam_test_vault' plugin:reload id=seam"
  },
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "esbuild": "^0.17.0",
    "eslint": "^10.10.0",
    "obsidian": "latest",
    "tslib": "^2.4.0",
    "tsx": "^4.23.12",
    "typescript": "^4.5.2"
  }
}
