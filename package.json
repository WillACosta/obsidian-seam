{
  "name": "obsidian-seam",
  "version": "3.1.0",
  "description": "Tag-driven note organization with automatic archiving and a Universal Palette.",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:quality": "pnpm format:check && pnpm lint",
    "changelog:extract": "node scripts/changelog.mjs extract",
    "changelog:generate": "node scripts/changelog.mjs generate",
    "changelog:validate": "node scripts/changelog.mjs validate",
    "release:check": "node scripts/changelog.mjs validate"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "esbuild": "^0.17.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "10.1.8",
    "moment": "2.29.4",
    "obsidian": "latest",
    "prettier": "3.9.10",
    "tslib": "^2.4.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
