{
  "name": "obsidian-seam",
  "version": "0.1.0",
  "description": "Tag-driven note organization with automatic archiving and a Universal Palette.",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "tsx --test tests/**/*.test.ts",
    "symlink": "node scripts/symlink.mjs",
    "changelog:extract": "node scripts/changelog.mjs extract",
    "changelog:generate": "node scripts/changelog.mjs generate",
    "changelog:validate": "node scripts/changelog.mjs validate",
    "release:check": "node scripts/changelog.mjs validate"
  },
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.17.0",
    "obsidian": "latest",
    "tslib": "^2.4.0",
    "tsx": "^4.23.12",
    "typescript": "^4.5.2"
  }
}
